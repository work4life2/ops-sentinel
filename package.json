{
  "name": "ops-sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "Slack bot that watches paid-API quotas and service health, alerts before they run out, and summarizes everything on /ops.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "node dist/index.js check",
    "serve": "node dist/index.js serve",
    "start": "node dist/index.js serve",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@slack/bolt": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.9.3"
  }
}
