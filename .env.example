# 复制为 .env.local 后填写（chmod 600）。.env.local 已被 git 忽略。
# 缺哪个变量，对应的检查就显示为“未配置”，不会告警。

# ── Slack（见 README「Slack 配置」）──────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# 告警发到哪个频道：频道 ID（频道链接最后一段，形如 C0123ABCD）。也可以写公开频道名，但必须加引号，否则 # 会被当成注释："#notify-money"
SLACK_CHANNEL_ID=
# 可选：严重告警前加的提醒，如 <!channel> 或 <@U0123ABCD>
SLACK_ALERT_MENTION=
# 可选：只允许这些用户使用命令（逗号分隔的用户 ID）；留空=所有人
SLACK_ALLOWED_USERS=
# 可选：斜杠命令名，需和 Slack App 里建的一致
SLACK_COMMAND=/ops

# ── 3D 卡牌 (holo-card-agent, 127.0.0.1:8787) ───────────────────
# 面板路径（不带开头的 /）：3dcardagent/pass/dashboard-path.txt
HOLO_DASHBOARD_PATH=

# ── FC 游戏搭子 (jev-fc-buddy, 127.0.0.1:8790) ──────────────────
# jev-fc-buddy/pass/admin-token.txt。写错会 401：本程序收到 401 会立即告警并暂停这项检查 6 小时
JEV_ADMIN_TOKEN=

# ── 热钱包地址（公开地址，不是私钥）──────────────────────────────
# 在服务器上：grep -h "^# wallet=" /opt/*/data/termix/.termix-a2a-session.* /opt/montage-studio/data/*/termix/.termix-a2a-session.*
HOLO_WALLET_ADDRESS=
JEV_WALLET_ADDRESS=
MONTAGE_WALLET_ADDRESS=
RENDERFARM_WALLET_ADDRESS=
BEATSMITH_WALLET_ADDRESS=
SKETCHBOARD_WALLET_ADDRESS=

# ── cun.ai 账户余额（3D 卡牌 + Montage 共用）─────────────────────
# 控制台 → 个人设置 → 生成「系统访问令牌」；用户 ID 在同一页
CUNAI_ACCESS_TOKEN=
CUNAI_USER_ID=
# 可选：某把 sk- key，只用来显示这把 key 的累计消费
CUNAI_API_KEY=

# ── Mobula（Termix 后端行情 K 线 / token logo）─────────────────────
# admin.mobula.io：API key；设置页的 Organization ID（或 Customer ID，二选一）
MOBULA_API_KEY=
MOBULA_ORGANIZATION_ID=
MOBULA_CUSTOMER_ID=
# 套餐每月 credits（Startup 125000 / Growth 1250000）和每月续费日（1-28）
MOBULA_MONTHLY_CREDITS=
MOBULA_BILLING_DAY=1

# Runway 不需要配置：余额由 Montage 进程通过它自己的 Runway MCP 登录查询（127.0.0.1:8795/api/runway/credits）
